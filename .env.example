# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).

# Which provider to use: "anthropic" or "moonshot"
LLM_PROVIDER=moonshot

MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
# Check the current model names in the Moonshot console before running.
MOONSHOT_MODEL=kimi-k2.6
MOONSHOT_THINKING=enabled

# Prices in USD per 1 million tokens. Copy them from the provider's pricing page.
# The evaluation uses these to compute cost per 1,000 transactions.
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=

# Step 8: the threshold you chose in Step 7 (on the validation set).
HYBRID_THRESHOLD=0.8
